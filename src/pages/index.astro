---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import Partners from '../components/Partners.astro';
import WhyUs from '../components/WhyUs.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout lang="fa" title="نکس‌سیس پرشیا | راهکارهای یکپارچه فناوری" description="ارائه‌دهنده‌ی راهکارهای یکپارچه فناوری اطلاعات، امنیت سایبری، هوشمندسازی ساختمان، اتوماسیون صنعتی و هوش مصنوعی">
  <Navbar lang="fa" />
  <main>
    <Hero lang="fa" />
    <About lang="fa" />
    <Services lang="fa" />
    <Projects lang="fa" />
    <Partners lang="fa" />
    <WhyUs lang="fa" />
    <Contact lang="fa" />
  </main>
  <Footer lang="fa" />
</Layout>

<script>
  function initSlider(trackId, sectionId, itemWidth) {
    var track = document.getElementById(trackId);
    var section = document.getElementById(sectionId);
    if (!track || !section) return;

    var prevBtn = section.querySelector('.prev');
    var nextBtn = section.querySelector('.next');
    
    var pos = 0;
    var visibleItems = Math.floor(track.parentElement.offsetWidth / itemWidth);
    var totalItems = track.children.length / 2;
    
    pos = -(totalItems * itemWidth) + (visibleItems * itemWidth);
    track.style.transform = 'translateX(' + pos + 'px)';

    nextBtn.addEventListener('click', function() {
      pos -= itemWidth;
      if (pos < -(totalItems * itemWidth)) pos = 0;
      track.style.transform = 'translateX(' + pos + 'px)';
    });

    prevBtn.addEventListener('click', function() {
      pos += itemWidth;
      if (pos > 0) pos = -(totalItems * itemWidth);
      track.style.transform = 'translateX(' + pos + 'px)';
    });
  }

  initSlider('proj-track', 'projects', 184);
  initSlider('part-track', 'partners', 204);
</script>