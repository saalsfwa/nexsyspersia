---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import Partners from '../components/Partners.astro';
import WhyUs from '../components/WhyUs.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout lang="fa" title="نکس‌سیس پرشیا | راهکارهای یکپارچه فناوری" description="ارائه‌دهنده‌ی راهکارهای یکپارچه فناوری اطلاعات، امنیت سایبری، هوشمندسازی ساختمان، اتوماسیون صنعتی و هوش مصنوعی">
  <Navbar lang="fa" />
  <main>
    <Hero lang="fa" />
    <About lang="fa" />
    <Services lang="fa" />
    <Projects lang="fa" />
    <Partners lang="fa" />
    <WhyUs lang="fa" />
    <Contact lang="fa" />
  </main>
  <Footer lang="fa" />
</Layout>

<script>
  // Slider Logic for Projects
  const projTrack = document.getElementById('proj-track');
  const projSection = document.getElementById('projects');
  if (projTrack && projSection) {
    const pPrev = projSection.querySelector('.prev');
    const pNext = projSection.querySelector('.next');
    let pPos = 0;
    const pItemW = 184; 
    const pVis = Math.floor(projTrack.parentElement.offsetWidth / pItemW);
    const pTotal = projTrack.children.length / 2;
    pPos = -(pTotal * pItemW) + (pVis * pItemW);
    projTrack.style.transform = 'translateX(' + pPos + 'px)';

    pNext.addEventListener('click', function() {
      pPos -= pItemW;
      if (pPos < -(pTotal * pItemW)) pPos = 0;
      projTrack.style.transform = 'translateX(' + pPos + 'px)';
    });
    pPrev.addEventListener('click', function() {
      pPos += pItemW;
      if (pPos > 0) pPos = -(pTotal * pItemW);
      projTrack.style.transform = 'translateX(' + pPos + 'px)';
    });
  }

  // Slider Logic for Partners
  const partTrack = document.getElementById('part-track');
  const partSection = document.getElementById('partners');
  if (partTrack && partSection) {
    const ptPrev = partSection.querySelector('.prev');
    const ptNext = partSection.querySelector('.next');
    let ptPos = 0;
    const ptItemW = 204; 
    const ptVis = Math.floor(partTrack.parentElement.offsetWidth / ptItemW);
    const ptTotal = partTrack.children.length / 2;
    ptPos = -(ptTotal * ptItemW) + (ptVis * ptItemW);
    partTrack.style.transform = 'translateX(' + ptPos + 'px)';

    ptNext.addEventListener('click', function() {
      ptPos -= ptItemW;
      if (ptPos < -(ptTotal * ptItemW)) ptPos = 0;
      partTrack.style.transform = 'translateX(' + ptPos + 'px)';
    });
    ptPrev.addEventListener('click', function() {
      ptPos += ptItemW;
      if (ptPos > 0) ptPos = -(ptTotal * ptItemW);
      partTrack.style.transform = 'translateX(' + ptPos + 'px)';
    });
  }
</script>