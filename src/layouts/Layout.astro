---
import '../styles/global.css';

interface Props {
  lang?: 'fa' | 'en';
  title: string;
  description: string;
}
const { lang = 'fa', title, description } = Astro.props;
---

<!doctype html>
<html lang={lang} dir={lang === 'fa' ? 'rtl' : 'ltr'}>
  <head>
    <script is:inline>
      (function () {
        var t = 'light';
        try { t = localStorage.getItem('nexsys-theme') || 'light'; } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <canvas id="neural-canvas"></canvas>
    <slot />
    <script is:inline src="/scripts/neural-network.js"></script>
  </body>
</html>