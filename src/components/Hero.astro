---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';
const t = {
  fa: {
    badge: 'پیشرو در فناوری‌های نوین',
    title1: 'آینده‌ی دیجیتال',
    title2: ' تکنولوژی برای همه',
    desc: 'نکس‌سیس پرشیا، ارائه‌دهنده‌ی راهکارهای یکپارچه فناوری اطلاعات، امنیت سایبری، هوشمندسازی ساختمان، اتوماسیون صنعتی و هوش مصنوعی.',
    cta1: 'مشاهده خدمات',
    cta2: ' مشاوره رایگان کلیک کنید'
  },
  en: {
    badge: 'Leading in Modern Technologies',
    title1: 'Building the Digital',
    title2: 'Future',
    desc: 'Nexsys Persia provides integrated IT, cybersecurity, smart building, industrial automation, and AI solutions for forward-thinking organizations.',
    cta1: 'Explore Services',
    cta2: 'Get Consultation'
  }
}[isFa ? 'fa' : 'en'];

const slides = [
  'https://s100.picofile.com/d/xwPwLKcK8fbSsoFfQ16WcEMiosf4tnt9nGPbkivc5z5tCBsSgqn029-ttL1dZYRiTBmyZ-x0EUkocNgzqjQ8NQ06ew4-9C7zgaxzS4rNq7Px9B70UqbbrLUNb8m8IK4/ChatGPT%20Image%20Sep%2010%2C%202026%2C%2008_02_13%20AM.png',
  'https://s100.picofile.com/d/K-Of5-kw4kTr_hE_0po3DhJaI7ew6EI594qSgAqP008AvB2b6jwK9VO3o982SIjqFsVXTJ-g_tyXs-dJy7huNx56Tgbv44bskmCVtJw-KxVyhFnNncW41t2tqbVUJ6Y/ChatGPT%20Image%20Sep%2010%2C%202026%2C%2008_09_29%20AM.png'
];
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-text fade-up">
        <div class="hero-badge">{t.badge}</div>
        <h1>
          {t.title1}<br/>
          <span class="gradient-text">{t.title2}</span>
        </h1>
        <p>{t.desc}</p>
        <div class="hero-buttons">
          <a href="#services" class="btn btn-primary">
            {t.cta1}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              {isFa ? '<><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></>' : '<><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></>'}
            </svg>
          </a>
          <a href="#contact" class="btn btn-outline">{t.cta2}</a>
        </div>
      </div>
      
      <div class="hero-slider fade-up">
        <div class="slider-container">
          {slides.map((src, i) => (
            <div class={`slide ${i === 0 ? 'active' : ''}`}>
              <img src={src} alt={`Slide ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))}
          <div class="slider-dots">
            {slides.map((_, i) => (
              <span class={`dot ${i === 0 ? 'active' : ''}`} data-index={i}></span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const container = document.querySelector('.slider-container');
  if (!container) {
    // اگر container پیدا نشد (صفحه انگلیسی)، دوباره جستجو کن
    const allContainers = document.querySelectorAll('.slider-container');
    allContainers.forEach(initSlider);
  } else {
    initSlider(container);
  }
  
  function initSlider(container) {
    const slides = container.querySelectorAll('.slide');
    const dots = container.querySelectorAll('.dot');
    if (slides.length === 0) return;
    
    let currentIndex = 0;
    
    function goToSlide(index) {
      slides[currentIndex].classList.remove('active');
      dots[currentIndex].classList.remove('active');
      currentIndex = index;
      slides[currentIndex].classList.add('active');
      dots[currentIndex].classList.add('active');
    }
    
    function nextSlide() {
      const next = (currentIndex + 1) % slides.length;
      goToSlide(next);
    }
    
    // تعویض خودکار هر 5 ثانیه
    const interval = setInterval(nextSlide, 5000);
    
    // کلیک روی dots
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        clearInterval(interval);
        goToSlide(i);
        // ری‌استارت تایمر
        setInterval(nextSlide, 5000);
      });
    });
  }
</script>