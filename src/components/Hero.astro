---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';
const t = {
  fa: {
    badge: 'پیشرو در فناوری‌های نوین',
    title1: ' نکس‌سیس پرشیا  ',
    title2: 'تکنولوژی برای همه ',
    desc: 'نکس‌سیس پرشیا، ارائه‌دهنده‌ی راهکارهای یکپارچه فناوری اطلاعات، امنیت سایبری، هوشمندسازی ساختمان، اتوماسیون صنعتی و هوش مصنوعی.',
    cta1: 'مشاهده خدمات',
    cta2: 'درخواست مشاوره'
  },
  en: {
    badge: 'Leading in Modern Technologies',
    title1: 'Building the Digital',
    title2: 'Future',
    desc: 'Nexsys Persia provides integrated IT, cybersecurity, smart building, industrial automation, and AI solutions.',
    cta1: 'Explore Services',
    cta2: 'Get Consultation'
  }
}[isFa ? 'fa' : 'en'];

const slides = [
  'https://s100.picofile.com/d/BREX9NDyIzSPo3XcNcKDsY06-1l64V_ocdVQpFg3Ws-Fq1apZXDLfq48ROnPOR02tWJN0XwVmqDDZaI5M3EaxxF5y1vPumnYFNl7g0XQ4ZCK34Lnuwj4zxLH-VM/1135D207-140D-4BFF-964D-82CBF4D132D0.png',
  'https://s100.picofile.com/d/O2pH1CWfbhmc-4k8TQ9Fx2uo9USqvEctyXbbGZsIMMz5vN_NiLg2jkTfCablph8GDA3LCruuV476C7eJXCC40AX8V7mo_Iqj85SvCSCQp8enPpPP/the-most-futuristic-house-2.webp',
  'https://s100.picofile.com/d/8bi-ZyW5CT7JAaCbfELUioqzSSaZ18RudLIILb5sPmWlrqzCm6__3dbuocHbWgu3VTT0FYgxsKJhayJ-Cw/2-11.webp'
];
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-text fade-up">
        <div class="hero-badge">{t.badge}</div>
        <h1>{t.title1}<br/><span class="gradient-text">{t.title2}</span></h1>
        <p>{t.desc}</p>
        <div class="hero-buttons">
          <a href="#services" class="btn btn-primary">{t.cta1} 
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              {isFa ? '<line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>' : '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>'}
            </svg>
          </a>
          <a href="#contact" class="btn btn-outline">{t.cta2}</a>
        </div>
      </div>
      
      <div class="hero-slider fade-up" id="hero-slider">
        <div class="slider-container">
          {slides.map((src, i) => (
            <div class={`slide ${i === 0 ? 'active' : ''}`}>
              <img src={src} alt={`Slide ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))}
          <div class="slider-dots">
            {slides.map((_, i) => (
              <span class={`dot ${i === 0 ? 'active' : ''}`} data-index={i}></span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const slider = document.getElementById('hero-slider');
  if (slider) {
    const slides = slider.querySelectorAll('.slide');
    const dots = slider.querySelectorAll('.dot');
    let currentIndex = 0;
    
    function goToSlide(index) {
      slides[currentIndex].classList.remove('active');
      dots[currentIndex].classList.remove('active');
      currentIndex = index;
      slides[currentIndex].classList.add('active');
      dots[currentIndex].classList.add('active');
    }
    
    setInterval(() => goToSlide((currentIndex + 1) % slides.length), 5000);
    dots.forEach((dot, i) => dot.addEventListener('click', () => goToSlide(i)));
  }
</script>