---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';

const projects = [
  'https://s100.picofile.com/d/uQ7KE7Jczywf3n2ZiQ_Uf6NzlmBa4gj9tLtC5kQaCGMz8ay3MkYlPKuD_N7UR78Xlbx8vSlh0ALDCKJ3NdEeCSrC/Picture15.webp',
  'https://s100.picofile.com/d/d1tcm3AO6ulMvM2E8FPCyRcayqt7o9IvFFvpKVgyuDVj5ilfiNUd_8EfHdLslOhzH4SqGKfgcWEtjpPUnyy3O7Y7/Picture10.webp',
  'https://s100.picofile.com/d/3kyDFHD5CkdJoLFw1XVA7yMYRxD72uDDf4MRM1Tws9i4Z8v2UsyB49UEr22VKjCS3nYA2QCWrfPaYnjHp-GLCfNf/Picture12.webp',
  'https://s100.picofile.com/d/INIC8z7OD6w7tHhVznNugS7_gPJKDf_ehiK9YQEmqwLHBBAiO_rO-zhPId16op4Sfs9Omb7EUQ17plDMnmJ0YWE/Picture2.webp',
  'https://s100.picofile.com/d/r9cXvWDcsvnfPkAdFzWJywrO_jI1QvLJy5QZLo0OlEQ5D1GPPxkroTPUvBCZlTxlKH3Kxc8bzJDkniNKSbnxowk/Picture1.webp',
  'https://s100.picofile.com/d/R2D6ZXlw2iCWx0GGJEXMmyBC5EYxtSQrui-MfO62t-XZtZ18DSUn--ZDRNnH7PwOGGo5ptRpZaC10ry7fHGziSU/Picture6.webp',
  'https://images.unsplash.com/photo-1551434678-e076c223a692?w=400&h=400&fit=crop'
];
---

<section class="section projects-section" id="projects">
  <div class="container">
    <h2 class="section-title" style="text-align: center;">
      {isFa ? 'نمونه‌کارهای ' : 'Featured '}
      <span class="gradient-text">
        {isFa ? 'شاخص' : 'Projects'}
      </span>
    </h2>

    <p class="section-subtitle" style="text-align: center; margin: 0 auto 40px;">
      {isFa
        ? 'گزیده‌ای از پروژه‌های اجرایی و موفق ما'
        : 'A selection of our successful executed projects'}
    </p>

    <div class="slider-wrapper">

      <button class="slider-btn prev" aria-label="Previous">
        &#10094;
      </button>

      <div class="marquee-container">
        <div class="marquee-content">

          <!-- مجموعه اول -->
          {projects.map(src => (
            <div class="project-item">
              <img src={src} alt="Project" loading="lazy" />
            </div>
          ))}

          <!-- مجموعه دوم برای حرکت بی‌نهایت -->
          {projects.map(src => (
            <div class="project-item">
              <img src={src} alt="Project" loading="lazy" />
            </div>
          ))}

        </div>
      </div>

      <button class="slider-btn next" aria-label="Next">
        &#10095;
      </button>

    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: 80px 0;
    overflow: hidden;
  }

  .slider-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
    position: relative;
  }

  .marquee-container {
    width: 100%;
    overflow: hidden;

    mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );

    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
  }

  .marquee-content {
    display: flex;
    gap: 24px;
    width: max-content;

    /* مقدار اولیه توسط JS تنظیم می‌شود */
    transform: translateX(0);

    will-change: transform;
  }

  .project-item {
    width: 160px;
    height: 160px;

    border-radius: 8px;
    overflow: hidden;

    border: 1px solid var(--color-border);

    flex-shrink: 0;

    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .project-item:hover {
    transform: scale(1.05);
    border-color: var(--color-accent);
  }

  .project-item img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    filter: grayscale(30%);

    transition: filter 0.3s ease;
  }

  .project-item:hover img {
    filter: grayscale(0%);
  }

  .slider-btn {
    background: rgba(255, 255, 255, 0.05);

    border: 1px solid var(--color-border);

    color: #fff;

    width: 44px;
    height: 44px;

    border-radius: 50%;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 1.2rem;

    transition: all 0.3s ease;

    flex-shrink: 0;

    z-index: 10;
  }

  .slider-btn:hover {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  .slider-btn:active {
    transform: scale(0.92);
  }

  @media (max-width: 768px) {
    .slider-wrapper {
      gap: 10px;
    }

    .slider-btn {
      width: 36px;
      height: 36px;
      font-size: 1rem;
    }

    .project-item {
      width: 120px;
      height: 120px;
    }

    .marquee-content {
      gap: 16px;
    }
  }
</style>

<script>
  const section = document.getElementById('projects');

  if (section) {
    const container = section.querySelector('.marquee-container');
    const track = section.querySelector('.marquee-content');
    const prevBtn = section.querySelector('.prev');
    const nextBtn = section.querySelector('.next');

    if (container && track && prevBtn && nextBtn) {

      let currentX = 0;
      let lastTime = performance.now();

      let isPaused = false;

      /*
       * سرعت حرکت خودکار
       * عدد کمتر = آرام‌تر
       * عدد بیشتر = سریع‌تر
       */
      const autoSpeed = 35;

      /*
       * فاصله هر عکس
       * width + gap
       */
      function getItemWidth() {
        const firstItem = track.querySelector('.project-item');

        if (!firstItem) return 184;

        const itemWidth = firstItem.getBoundingClientRect().width;

        const styles = window.getComputedStyle(track);
        const gap = parseFloat(styles.columnGap || styles.gap || '0');

        return itemWidth + gap;
      }

      /*
       * چون دو مجموعه کاملاً یکسان داریم،
       * عرض نصف Track مرز Loop ماست.
       */
      function getLoopWidth() {
        return track.scrollWidth / 2;
      }

      /*
       * موقعیت اولیه:
       *
       * مجموعه دوم را نشان می‌دهیم.
       *
       * بنابراین همان لحظه اول ردیف پر است
       * و عکس‌ها منتظر نمی‌مانند که از سمت چپ وارد شوند.
       */
      function setInitialPosition() {
        const loopWidth = getLoopWidth();

        currentX = -loopWidth;

        track.style.transform = `translate3d(${currentX}px, 0, 0)`;
      }

      /*
       * Loop بی‌نهایت
       *
       * وقتی از یک مجموعه عبور کردیم،
       * بدون اینکه کاربر متوجه شود به مجموعه مشابه
       * منتقل می‌شویم.
       */
      function normalizePosition() {
        const loopWidth = getLoopWidth();

        if (!loopWidth) return;

        while (currentX <= -loopWidth) {
          currentX += loopWidth;
        }

        while (currentX >= 0) {
          currentX -= loopWidth;
        }
      }

      /*
       * حرکت خودکار
       */
      function animate(time) {
        const delta = Math.min(time - lastTime, 50);

        lastTime = time;

        if (!isPaused) {

          /*
           * حرکت به سمت راست
           */
          currentX += (autoSpeed * delta) / 1000;

          normalizePosition();

          track.style.transform =
            `translate3d(${currentX}px, 0, 0)`;
        }

        requestAnimationFrame(animate);
      }

      /*
       * حرکت دستی
       */
      function moveBy(direction) {

        const itemWidth = getItemWidth();

        /*
         * direction:
         *
         * -1 = چپ
         * +1 = راست
         */

        currentX += direction * itemWidth;

        normalizePosition();

        /*
         * تغییر موقعیت سریع ولی نرم
         */
        track.style.transition =
          'transform 0.45s cubic-bezier(0.22, 1, 0.36, 1)';

        track.style.transform =
          `translate3d(${currentX}px, 0, 0)`;

        /*
         * بعد از حرکت فلش،
         * دوباره وارد حالت حرکت عادی می‌شویم.
         */
        setTimeout(() => {
          track.style.transition = 'none';

          lastTime = performance.now();

        }, 450);
      }

      /*
       * فلش چپ
       */
      prevBtn.addEventListener('click', () => {
        moveBy(-1);
      });

      /*
       * فلش راست
       */
      nextBtn.addEventListener('click', () => {
        moveBy(1);
      });

      /*
       * توقف هنگام Hover
       */
      container.addEventListener('mouseenter', () => {
        isPaused = true;
      });

      /*
       * ادامه حرکت بعد از خروج موس
       */
      container.addEventListener('mouseleave', () => {
        isPaused = false;
        lastTime = performance.now();
      });

      /*
       * در Resize دوباره موقعیت را محاسبه می‌کنیم.
       */
      window.addEventListener('resize', () => {
        setInitialPosition();
      });

      /*
       * تنظیم موقعیت اولیه
       */
      setInitialPosition();

      /*
       * شروع حرکت
       */
      requestAnimationFrame(animate);
    }
  }
</script>