---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';

const projects = [
  '/images/4.webp',
  '/images/5.webp',
  '/images/6.webp',
  '/images/7.webp',
  '/images/8.webp',
  '/images/9.webp',
  '/images/10.webp',
  '/images/11.webp',
  '/images/12.webp',
  '/images/13.webp',
  '/images/14.webp',
  '/images/15.webp'
];
---

<section class="section projects-section" id="projects">
  <div class="container">
    <h2 class="section-title" style="text-align: center;">
      {isFa ? 'پروژه های ' : 'Featured '}<span class="gradient-text">{isFa ? 'شاخص' : 'Projects'}</span>
    </h2>
    <p class="section-subtitle" style="text-align: center; margin: 0 auto 40px;">
      {isFa ? 'گزیده‌ای از پروژه‌های اجرایی و موفق ما' : 'A selection of our successful executed projects'}
    </p>
    
    <div class="projects-grid" id="proj-grid">
      {projects.map((src, i) => (
        <div class={`project-item ${i < 6 ? 'visible' : ''}`}>
          <img src={src} alt="Project" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section { padding: 80px 0; overflow: hidden; }
  
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 24px;
  }
  
  .project-item {
    display: none;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .project-item.visible { display: block; }
  
  .project-item img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(30%); }
  .project-item:hover img { filter: grayscale(0%); }
  
  @media (max-width: 1024px) { .projects-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 768px) { .projects-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .projects-grid { grid-template-columns: 1fr; } }
</style>

<script>
  var grid = document.getElementById('proj-grid');
  if (grid) {
    var items = grid.querySelectorAll('.project-item');
    var perSlide = 6;
    var pages = Math.ceil(items.length / perSlide);
    var page = 0;
    
    setInterval(function () {
      page = (page + 1) % pages;
      var start = page * perSlide;
      var end = start + perSlide;
      for (var i = 0; i < items.length; i++) {
        if (i >= start && i < end) {
          items[i].classList.add('visible');
        } else {
          items[i].classList.remove('visible');
        }
      }
    }, 5000);
  }
</script>