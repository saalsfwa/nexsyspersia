```astro
---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';

const projects = [
  'https://images.unsplash.com/photo-1497366216548-37526070297c?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1497215728101-856f4ea42174?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1551434678-e076c223a692?w=400&h=400&fit=crop'
];
---

<section class="section projects-section" id="projects">
  <div class="container">

    <h2 class="section-title" style="text-align: center;">
      {isFa ? 'نمونه‌کارهای ' : 'Featured '}
      <span class="gradient-text">
        {isFa ? 'شاخص' : 'Projects'}
      </span>
    </h2>

    <p class="section-subtitle" style="text-align: center; margin: 0 auto 40px;">
      {isFa
        ? 'گزیده‌ای از پروژه‌های اجرایی و موفق ما'
        : 'A selection of our successful executed projects'}
    </p>

    <div class="slider-wrapper">

      <button
        class="slider-btn prev"
        aria-label={isFa ? 'قبلی' : 'Previous'}
        type="button"
      >
        &#10094;
      </button>

      <div class="marquee-container">

        <div class="marquee-content">

          <!-- سری اول -->
          {projects.map(src => (
            <div class="project-item">
              <img
                src={src}
                alt={isFa ? 'نمونه‌کار' : 'Project'}
                loading="lazy"
              />
            </div>
          ))}

          <!-- سری دوم برای Loop بی‌نهایت -->
          {projects.map(src => (
            <div class="project-item">
              <img
                src={src}
                alt={isFa ? 'نمونه‌کار' : 'Project'}
                loading="lazy"
              />
            </div>
          ))}

        </div>

      </div>

      <button
        class="slider-btn next"
        aria-label={isFa ? 'بعدی' : 'Next'}
        type="button"
      >
        &#10095;
      </button>

    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: 80px 0;
    overflow: hidden;
  }

  .slider-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
    position: relative;
    width: 100%;
  }

  .marquee-container {
    width: 100%;
    overflow: hidden;

    mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );

    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
  }

  /*
   * مهم:
   * خود Track همیشه LTR است.
   * بنابراین RTL صفحه روی ترتیب عکس‌ها
   * تأثیر نمی‌گذارد.
   */
  .marquee-content {
    display: flex;
    flex-direction: row;
    direction: ltr;

    gap: 24px;
    width: max-content;

    transform: translate3d(0, 0, 0);

    will-change: transform;
  }

  .project-item {
    width: 160px;
    height: 160px;

    border-radius: 8px;
    overflow: hidden;

    border: 1px solid var(--color-border);

    flex: 0 0 160px;

    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .project-item:hover {
    transform: scale(1.05);
    border-color: var(--color-accent);
  }

  .project-item img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    filter: grayscale(30%);

    transition: filter 0.3s ease;
  }

  .project-item:hover img {
    filter: grayscale(0%);
  }

  .slider-btn {
    background: rgba(255, 255, 255, 0.05);

    border: 1px solid var(--color-border);

    color: #fff;

    width: 44px;
    height: 44px;

    border-radius: 50%;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 1.2rem;

    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.15s ease;

    flex-shrink: 0;

    z-index: 10;
  }

  .slider-btn:hover {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  .slider-btn:active {
    transform: scale(0.92);
  }

  @media (max-width: 768px) {

    .projects-section {
      padding: 60px 0;
    }

    .slider-wrapper {
      gap: 10px;
    }

    .slider-btn {
      width: 36px;
      height: 36px;
      font-size: 1rem;
    }

    .project-item {
      width: 120px;
      height: 120px;
      flex-basis: 120px;
    }

    .marquee-content {
      gap: 16px;
    }
  }
</style>

<script>
  const section = document.getElementById('projects');

  if (section) {

    const container =
      section.querySelector('.marquee-container');

    const track =
      section.querySelector('.marquee-content');

    const prevBtn =
      section.querySelector('.prev');

    const nextBtn =
      section.querySelector('.next');

    if (
      container &&
      track &&
      prevBtn &&
      nextBtn
    ) {

      /*
       * تشخیص زبان صفحه
       */
      const isRTL =
        document.documentElement.dir === 'rtl' ||
        document.documentElement.lang === 'fa' ||
        document.documentElement.lang?.startsWith('fa');

      /*
       * موقعیت فعلی Track
       */
      let currentX = 0;

      /*
       * زمان آخرین Frame
       */
      let lastTime = performance.now();

      /*
       * وضعیت توقف
       */
      let isPaused = false;

      /*
       * سرعت حرکت خودکار
       *
       * عدد بیشتر = سریع‌تر
       * عدد کمتر = آرام‌تر
       */
      const autoSpeed = 35;

      /*
       * گرفتن عرض یک آیتم به همراه Gap
       */
      function getItemWidth() {

        const firstItem =
          track.querySelector('.project-item');

        if (!firstItem) {
          return 184;
        }

        const itemWidth =
          firstItem.getBoundingClientRect().width;

        const styles =
          window.getComputedStyle(track);

        const gap =
          parseFloat(
            styles.columnGap ||
            styles.gap ||
            '0'
          );

        return itemWidth + gap;
      }

      /*
       * عرض یک مجموعه کامل از تصاویر
       *
       * چون دو مجموعه کاملاً یکسان داریم،
       * نصف Track برابر با یک Loop کامل است.
       */
      function getLoopWidth() {

        return track.scrollWidth / 2;
      }

      /*
       * تنظیم موقعیت اولیه
       *
       * از همان ابتدا سری دوم تصاویر
       * نمایش داده می‌شود.
       *
       * بنابراین صفحه خالی شروع نمی‌شود.
       */
      function setInitialPosition() {

        const loopWidth =
          getLoopWidth();

        if (!loopWidth) {
          return;
        }

        currentX = -loopWidth;

        track.style.transition = 'none';

        track.style.transform =
          `translate3d(${currentX}px, 0, 0)`;
      }

      /*
       * جلوگیری از خروج Track از محدوده
       *
       * این قسمت Loop بی‌نهایت را ایجاد می‌کند.
       */
      function normalizePosition() {

        const loopWidth =
          getLoopWidth();

        if (!loopWidth) {
          return;
        }

        /*
         * اگر به انتهای سمت چپ رسیدیم،
         * یک مجموعه به جلو برمی‌گردیم.
         */
        while (currentX <= -loopWidth) {
          currentX += loopWidth;
        }

        /*
         * اگر به سمت راست بیش از حد رفتیم،
         * یک مجموعه به عقب می‌رویم.
         */
        while (currentX >= 0) {
          currentX -= loopWidth;
        }
      }

      /*
       * حرکت خودکار
       */
      function animate(time) {

        const delta =
          Math.min(
            time - lastTime,
            50
          );

        lastTime = time;

        if (!isPaused) {

          /*
           * فارسی:
           * حرکت راست به چپ
           */
          if (isRTL) {

            currentX -=
              (autoSpeed * delta) / 1000;

          /*
           * انگلیسی:
           * حرکت چپ به راست
           */
          } else {

            currentX +=
              (autoSpeed * delta) / 1000;
          }

          normalizePosition();

          track.style.transform =
            `translate3d(${currentX}px, 0, 0)`;
        }

        requestAnimationFrame(animate);
      }

      /*
       * حرکت دستی با فلش
       */
      function moveBy(direction) {

        const itemWidth =
          getItemWidth();

        /*
         * در فارسی جهت حرکت فلش‌ها
         * نسبت به انگلیسی معکوس می‌شود.
         */
        const actualDirection =
          isRTL
            ? -direction
            : direction;

        currentX +=
          actualDirection * itemWidth;

        normalizePosition();

        /*
         * حرکت نرم
         */
        track.style.transition =
          'transform 0.45s cubic-bezier(0.22, 1, 0.36, 1)';

        track.style.transform =
          `translate3d(${currentX}px, 0, 0)`;

        /*
         * بعد از حرکت دستی،
         * دوباره وارد حرکت عادی شو.
         */
        setTimeout(() => {

          track.style.transition =
            'none';

          lastTime =
            performance.now();

        }, 450);
      }

      /*
       * دکمه قبلی
       */
      prevBtn.addEventListener(
        'click',
        () => {
          moveBy(-1);
        }
      );

      /*
       * دکمه بعدی
       */
      nextBtn.addEventListener(
        'click',
        () => {
          moveBy(1);
        }
      );

      /*
       * توقف حرکت هنگام Hover
       */
      container.addEventListener(
        'mouseenter',
        () => {
          isPaused = true;
        }
      );

      /*
       * ادامه حرکت بعد از خروج موس
       */
      container.addEventListener(
        'mouseleave',
        () => {

          isPaused = false;

          lastTime =
            performance.now();
        }
      );

      /*
       * Resize
       *
       * بعد از تغییر اندازه صفحه،
       * Loop دوباره محاسبه می‌شود.
       */
      let resizeTimer;

      window.addEventListener(
        'resize',
        () => {

          clearTimeout(resizeTimer);

          resizeTimer =
            setTimeout(() => {

              setInitialPosition();

            }, 150);
        }
      );

      /*
       * اجرای اولیه
       */
      setInitialPosition();

      /*
       * شروع انیمیشن
       */
      requestAnimationFrame(animate);
    }
  }
</script>
```
