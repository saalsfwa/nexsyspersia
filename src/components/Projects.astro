---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';

const projects = [
  'https://images.unsplash.com/photo-1497366216548-37526070297c?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1497215728101-856f4ea42174?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=400&h=400&fit=crop',
  'https://images.unsplash.com/photo-1551434678-e076c223a692?w=400&h=400&fit=crop'
];
---

<section class="section projects-section" id="projects">
  <div class="container">
    <h2 class="section-title" style="text-align: center;">
      {isFa ? 'نمونه‌کارهای ' : 'Featured '}<span class="gradient-text">{isFa ? 'شاخص' : 'Projects'}</span>
    </h2>
    <p class="section-subtitle" style="text-align: center; margin: 0 auto 40px;">
      {isFa ? 'گزیده‌ای از پروژه‌های اجرایی و موفق ما' : 'A selection of our successful executed projects'}
    </p>
    
    <div class="slider-wrapper">
      <button class="slider-btn prev" aria-label="Previous">&#10094;</button>
      
      <div class="marquee-container">
        <div class="marquee-content">
          {[...projects, ...projects].map(src => (
            <div class="project-item"><img src={src} alt="Project" loading="lazy" /></div>
          ))}
        </div>
      </div>
      
      <button class="slider-btn next" aria-label="Next">&#10095;</button>
    </div>
  </div>
</section>

<style>
  .projects-section { padding: 80px 0; overflow: hidden; }
  .slider-wrapper { display: flex; align-items: center; gap: 20px; position: relative; }
  .marquee-container { width: 100%; overflow: hidden; mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); }
  .marquee-content { display: flex; gap: 24px; width: max-content; animation: scrollRight 30s linear infinite; }
  .marquee-content:hover { animation-play-state: paused; } /* توقف هنگام هاور */
  
  .project-item { width: 160px; height: 160px; border-radius: 8px; overflow: hidden; border: 1px solid var(--color-border); flex-shrink: 0; transition: transform 0.3s ease; }
  .project-item:hover { transform: scale(1.05); border-color: var(--color-accent); }
  .project-item img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(30%); transition: filter 0.3s; }
  .project-item:hover img { filter: grayscale(0%); }
  
  .slider-btn { background: rgba(255,255,255,0.05); border: 1px solid var(--color-border); color: #fff; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: all 0.3s; flex-shrink: 0; z-index: 10; }
  .slider-btn:hover { background: #fff; color: #000; border-color: #fff; }
  
  @keyframes scrollRight {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  
  @media (max-width: 768px) {
    .slider-btn { width: 36px; height: 36px; font-size: 1rem; }
    .project-item { width: 120px; height: 120px; }
  }
</style>

<script>
  // منطق جاوااسکریپت فقط برای فلش‌ها (بدون تداخل با انیمیشن CSS)
  const section = document.getElementById('projects');
  if (section) {
    const track = section.querySelector('.marquee-content');
    const prevBtn = section.querySelector('.prev');
    const nextBtn = section.querySelector('.next');
    
    let manualOffset = 0;
    const itemWidth = 184; // 160px width + 24px gap
    
    // متوقف کردن انیمیشن CSS وقتی کاربر دکمه می‌زند
    function applyManualTransform() {
      track.style.animation = 'none';
      track.style.transform = `translateX(${manualOffset}px)`;
    }

    nextBtn.addEventListener('click', () => {
      manualOffset -= itemWidth;
      applyManualTransform();
    });

    prevBtn.addEventListener('click', () => {
      manualOffset += itemWidth;
      applyManualTransform();
    });
  }
</script>