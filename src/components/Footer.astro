<!-- v2-fix -->
---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';
const t = {
  fa: {
    about: 'ارائه‌دهنده‌ی راهکارهای یکپارچه فناوری اطلاعات، امنیت، هوشمندسازی و هوش مصنوعی برای سازمان‌های پیشرو.',
    services: 'خدمات', company: 'شرکت', contact: 'تماس',
    projects: 'نمونه‌کارها', partners: 'همراهان استراتژیک',
    email: 'ایمیل', phone: 'تلفن',
    rights: '© ۲۰۲۶ نکس‌سیس پرشیا. تمامی حقوق محفوظ است.'
  },
  en: {
    about: 'Provider of integrated IT, security, smart building, and AI solutions for forward-thinking organizations.',
    services: 'Services', company: 'Company', contact: 'Contact',
    projects: 'Projects', partners: 'Partners',
    email: 'Email', phone: 'Phone',
    rights: '© 2026 Nexsys Persia. All rights reserved.'
  }
}[isFa ? 'fa' : 'en'];
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <div class="logo" style="color: white;">NEXSYS<span>PERSIA</span></div>
        <p>{t.about}</p>
      </div>
      <div>
        <h4>{t.services}</h4>
        <ul class="footer-links">
          <li><a href="#services">IT & Infrastructure</a></li>
          <li><a href="#services">Cybersecurity</a></li>
          <li><a href="#services">Smart Building</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.company}</h4>
        <ul class="footer-links">
          <li><a href="#projects">{t.projects}</a></li>
          <li><a href="#partners">{t.partners}</a></li>
          <li><a href="#about">About Us</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.contact}</h4>
        <ul class="footer-links">
          <li><a href="mailto:info@nexsyspersia.ir">{t.email}: info@nexsyspersia.ir</a></li>
          <li><a href="tel:+989161140612" dir="ltr">{t.phone}: 0916 114 0612</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">{t.rights}</div>
  </div>
</footer>