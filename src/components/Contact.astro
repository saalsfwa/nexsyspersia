---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';
const t = {
  fa: {
    title: 'تماس با ما',
    subtitle: 'آماده‌ی شروع پروژه‌ی بعدی شما هستیم',
    desc: 'برای دریافت مشاوره‌ی رایگان و بررسی نیازهای سازمان خود، با ما در تماس باشید. تیم متخصص ما در اسرع وقت پاسخگوی شما خواهد بود.',
    address: 'آدرس دفتر مرکزی', 
    addressVal: 'اهواز، کیان‌آباد، بین ۱۴ و ۱۵ غربی، مجتمع هشت بهشت، طبقه سوم',
    phone: 'تلفن تماس', 
    phoneVal: '۰۹۱۶۱۱۴۰۶۱۲',
    email: 'ایمیل', 
    emailVal: 'info@nexsyspersia.ir',
    name: 'نام و نام خانوادگی', 
    emailLabel: 'ایمیل',
    subject: 'موضوع', 
    message: 'پیام شما', 
    send: 'ارسال پیام'
  },
  en: {
    title: 'Contact Us',
    subtitle: 'Ready to start your next project',
    desc: 'Contact us for a free consultation and to assess your organization needs. Our expert team will respond as soon as possible.',
    address: 'Head Office', 
    addressVal: 'Ahvaz, Kianabad, Between 14th and 15th West, Hasht Behesht Complex, 3rd Floor',
    phone: 'Phone', 
    phoneVal: '+98 916 114 0612',
    email: 'Email', 
    emailVal: 'info@nexsyspersia.ir',
    name: 'Full Name', 
    emailLabel: 'Email',
    subject: 'Subject', 
    message: 'Your Message', 
    send: 'Send Message'
  }
}[isFa ? 'fa' : 'en'];
const icons = {
  map: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>',
  phone: '<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>',
  mail: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>'
};
---
<section class="section" id="contact">
  <div class="container">
    <h2 class="section-title"><span class="gradient-text">{t.title}</span></h2>
    <p class="section-subtitle">{t.subtitle}</p>
    <div class="contact-grid">
      <div class="contact-info">
        <h3>{t.desc}</h3>
        <div class="contact-item">
          <div class="contact-item-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.map} />
          </div>
          <div class="contact-item-text"><strong>{t.address}</strong><span>{t.addressVal}</span></div>
        </div>
        <div class="contact-item">
          <div class="contact-item-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.phone} />
          </div>
          <div class="contact-item-text"><strong>{t.phone}</strong><span dir="ltr">{t.phoneVal}</span></div>
        </div>
        <div class="contact-item">
          <div class="contact-item-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.mail} />
          </div>
          <div class="contact-item-text"><strong>{t.email}</strong><span>{t.emailVal}</span></div>
        </div>
        <div class="social-links">
          <a href="#" class="social-link" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="#" class="social-link" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="#" class="social-link" aria-label="Telegram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </a>
          <a href="#" class="social-link" aria-label="Twitter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
          </a>
        </div>

      </div>
      <form class="contact-form" action="https://formspree.io/f/your-form-id" method="POST">
        <div class="form-group"><label>{t.name}</label><input type="text" name="name" required /></div>
        <div class="form-group"><label>{t.emailLabel}</label><input type="email" name="email" required /></div>
        <div class="form-group"><label>{t.subject}</label><input type="text" name="subject" required /></div>
        <div class="form-group"><label>{t.message}</label><textarea name="message" required></textarea></div>
        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">{t.send}</button>
      </form>
    </div>
  </div>
</section>