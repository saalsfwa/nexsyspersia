---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';

const partners = [
  'https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg',
  'https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg',
  'https://upload.wikimedia.org/wikipedia/commons/4/44/Microsoft_logo.svg',
  'https://upload.wikimedia.org/wikipedia/commons/f/fa/Apple_logo_black.svg',
  'https://upload.wikimedia.org/wikipedia/commons/0/08/Cisco_logo_blue_2016.svg',
  'https://upload.wikimedia.org/wikipedia/commons/5/51/IBM_logo.svg',
  'https://upload.wikimedia.org/wikipedia/commons/0/0c/Huawei_Logo.svg'
];
---

<section class="section partners-section" id="partners">
  <div class="container">
    <h2 class="section-title" style="text-align: center;">
      {isFa ? 'همراهان ' : 'Strategic '}<span class="gradient-text">{isFa ? 'استراتژیک' : 'Partners'}</span>
    </h2>
    <p class="section-subtitle" style="text-align: center; margin: 0 auto 40px;">
      {isFa ? 'برندهای معتبری که به آن‌ها افتخار می‌کنیم' : 'Prestigious brands we are proud to partner with'}
    </p>
    
    <div class="slider-wrapper">
      <button class="slider-btn prev" aria-label="Previous">&#10094;</button>
      
      <div class="marquee-container">
        <div class="marquee-content partners-track">
          {[...partners, ...partners].map(src => (
            <div class="partner-item"><img src={src} alt="Partner Logo" loading="lazy" /></div>
          ))}
        </div>
      </div>
      
      <button class="slider-btn next" aria-label="Next">&#10095;</button>
    </div>
  </div>
</section>

<style>
  .partners-section { padding: 60px 0 100px; overflow: hidden; }
  .slider-wrapper { display: flex; align-items: center; gap: 20px; position: relative; }
  .marquee-container { width: 100%; overflow: hidden; mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); }
  .marquee-content { display: flex; gap: 24px; width: max-content; animation: scrollRight 25s linear infinite; }
  .marquee-content:hover { animation-play-state: paused; }
  
  .partner-item { width: 180px; height: 80px; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(255,255,255,0.02); border: 1px solid var(--color-border); border-radius: 8px; flex-shrink: 0; transition: all 0.3s ease; }
  .partner-item:hover { background: rgba(255,255,255,0.05); border-color: var(--color-accent); }
  .partner-item img { max-width: 100%; max-height: 100%; object-fit: contain; filter: brightness(0) invert(1) opacity(0.6); transition: filter 0.3s; }
  .partner-item:hover img { filter: brightness(0) invert(1) opacity(1); }
  
  .slider-btn { background: rgba(255,255,255,0.05); border: 1px solid var(--color-border); color: #fff; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: all 0.3s; flex-shrink: 0; z-index: 10; }
  .slider-btn:hover { background: #fff; color: #000; border-color: #fff; }
  
  @keyframes scrollRight {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  
  @media (max-width: 768px) {
    .slider-btn { width: 36px; height: 36px; font-size: 1rem; }
    .partner-item { width: 140px; height: 60px; }
  }
</style>

<script>
  const section = document.getElementById('partners');
  if (section) {
    const track = section.querySelector('.marquee-content');
    const prevBtn = section.querySelector('.prev');
    const nextBtn = section.querySelector('.next');
    
    let manualOffset = 0;
    const itemWidth = 204; // 180px width + 24px gap
    
    function applyManualTransform() {
      track.style.animation = 'none';
      track.style.transform = `translateX(${manualOffset}px)`;
    }

    nextBtn.addEventListener('click', () => {
      manualOffset -= itemWidth;
      applyManualTransform();
    });

    prevBtn.addEventListener('click', () => {
      manualOffset += itemWidth;
      applyManualTransform();
    });
  }
</script>