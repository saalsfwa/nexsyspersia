---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';

// لیست پالایش شده: حذف تکرارها و موارد بدون لوگوی استاندارد
const partners = [
  'Cisco', 'Hewlett Packard Enterprise', 'Dell Technologies', 'IBM', 'Microsoft', 
  'Huawei', 'Palo Alto Networks', 'Fortinet', 'CrowdStrike', 'Check Point Software Technologies',
  'OpenAI', 'NVIDIA', 'Google DeepMind', 'Anthropic', 'Sophos',
  'Kaspersky', 'Hikvision', 'Dahua Technology', 'Axis Communications', 'Hanwha Vision',
  'Bosch', 'Avigilon', 'Siemens', 'Schneider Electric', 'Honeywell',
  'Johnson Controls', 'ABB', 'Rockwell Automation', 'Emerson', 'Carrier',
  'Nokia', 'Ericsson', 'Juniper Networks', 'CommScope', 'Crestron',
  'Lutron', 'KNX', 'Somfy', 'Legrand', 'Google Home',
  'Amazon Alexa', 'Apple Home', 'Samsung SmartThings', 'Philips Hue'
];

// تابع هوشمند تولید لینک لوگو
const getLogoUrl = (name: string) => {
  const map: Record<string, string> = {
    'Hewlett Packard Enterprise': 'hpe',
    'Palo Alto Networks': 'paloaltonetworks',
    'Check Point Software Technologies': 'checkpoint',
    'Google DeepMind': 'google',
    'Hanwha Vision': 'hanwha',
    'Axis Communications': 'axis',
    'Johnson Controls': 'johnsoncontrols',
    'Rockwell Automation': 'rockwellautomation',
    'Juniper Networks': 'junipernetworks',
    'Google Home': 'googlehome',
    'Amazon Alexa': 'amazonalexa',
    'Apple Home': 'apple',
    'Samsung SmartThings': 'smartthings',
    'Philips Hue': 'philipshue',
    'Schneider Electric': 'schneiderelectric'
  };
  
  const slug = map[name] || name.toLowerCase().replace(/\s+/g, '');
  return `https://cdn.simpleicons.org/${slug}/FFFFFF`;
};
---

<section class="section partners-section" id="partners">
  <div class="container">
    <h2 class="section-title" style="text-align: center;">
      {isFa ? 'همراهان ' : 'Strategic '}<span class="gradient-text">{isFa ? 'استراتژیک' : 'Partners'}</span>
    </h2>
    <p class="section-subtitle" style="text-align: center; margin: 0 auto 40px;">
      {isFa ? 'برندهای معتبری که به آن‌ها افتخار می‌کنیم' : 'Prestigious brands we are proud to partner with'}
    </p>
    
    <div class="slider-wrapper">
      <button class="slider-btn prev" aria-label="Previous">&#10094;</button>
      
      <div class="marquee-container">
        <div class="marquee-content">
          {[...partners, ...partners].map(name => (
            <div class="partner-item">
              <img src={getLogoUrl(name)} alt={name} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
      
      <button class="slider-btn next" aria-label="Next">&#10095;</button>
    </div>
  </div>
</section>

<style>
  .partners-section { padding: 60px 0 100px; overflow: hidden; }
  .slider-wrapper { display: flex; align-items: center; gap: 20px; position: relative; }
  .marquee-container { width: 100%; overflow: hidden; mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); }
  .marquee-content { display: flex; gap: 24px; width: max-content; animation: scrollRight 40s linear infinite; }
  .marquee-content:hover { animation-play-state: paused; }
  
  .partner-item { 
    width: 160px; 
    height: 80px; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    padding: 16px; 
    background: rgba(255,255,255,0.02); 
    border: 1px solid var(--color-border); 
    border-radius: 8px; 
    flex-shrink: 0; 
    transition: all 0.3s ease;
  }
  .partner-item:hover { background: rgba(255,255,255,0.05); border-color: var(--color-accent); transform: scale(1.05); }
  .partner-item img { max-width: 100%; max-height: 100%; object-fit: contain; opacity: 0.7; transition: opacity 0.3s; }
  .partner-item:hover img { opacity: 1; }
  
  .slider-btn { background: rgba(255,255,255,0.05); border: 1px solid var(--color-border); color: #fff; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: all 0.3s; flex-shrink: 0; z-index: 10; }
  .slider-btn:hover { background: #fff; color: #000; border-color: #fff; }
  
  @keyframes scrollRight {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  
  @media (max-width: 768px) {
    .slider-btn { width: 36px; height: 36px; font-size: 1rem; }
    .partner-item { width: 120px; height: 60px; }
  }
</style>

<script>
  const section = document.getElementById('partners');
  if (section) {
    const track = section.querySelector('.marquee-content');
    const prevBtn = section.querySelector('.prev');
    const nextBtn = section.querySelector('.next');
    
    const itemWidth = 184; // 160px + 24px gap
    const totalItems = track.children.length / 2;
    const visibleItems = Math.floor(track.parentElement.offsetWidth / itemWidth);
    
    // پر کردن اولیه صفحه
    let currentPos = -(totalItems * itemWidth) + (visibleItems * itemWidth);
    track.style.transform = `translateX(${currentPos}px)`;
    
    setTimeout(() => {
      track.style.animation = 'scrollRight 40s linear infinite';
    }, 50);

    function stopAnimation() {
      track.style.animation = 'none';
      track.style.transform = `translateX(${currentPos}px)`;
    }

    nextBtn.addEventListener('click', () => {
      stopAnimation();
      currentPos -= itemWidth;
      track.style.transform = `translateX(${currentPos}px)`;
    });

    prevBtn.addEventListener('click', () => {
      stopAnimation();
      currentPos += itemWidth;
      track.style.transform = `translateX(${currentPos}px)`;
    });
  }
</script>