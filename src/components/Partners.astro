---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';

const partners = [
  'Cisco', 'Hewlett Packard Enterprise', 'Dell Technologies', 'IBM', 'Microsoft', 
  'Huawei', 'Palo Alto Networks', 'Fortinet', 'CrowdStrike', 'Check Point Software Technologies',
  'OpenAI', 'NVIDIA', 'Google DeepMind', 'Anthropic', 'Sophos',
  'Kaspersky', 'Hikvision', 'Dahua Technology', 'Axis Communications', 'Hanwha Vision',
  'Bosch', 'Avigilon', 'Siemens', 'Schneider Electric', 'Honeywell',
  'Johnson Controls', 'ABB', 'Rockwell Automation', 'Emerson', 'Carrier',
  'Nokia', 'Ericsson', 'Juniper Networks', 'CommScope', 'Crestron',
  'Lutron', 'KNX', 'Somfy', 'Legrand', 'Google Home',
  'Amazon Alexa', 'Apple Home', 'Samsung SmartThings', 'Philips Hue'
];

// شناسه‌های اصلاح‌شده برای برندهای خاص
const getLogoUrl = (name: string) => {
  const map: Record<string, string> = {
    'Hewlett Packard Enterprise': 'hpe',
    'Dell Technologies': 'dell',
    'Palo Alto Networks': 'paloaltonetworks',
    'Check Point Software Technologies': 'checkpoint',
    'Google DeepMind': 'deepmind',
    'Hanwha Vision': 'hanwhavision',
    'Axis Communications': 'axis',
    'Dahua Technology': 'dahua',
    'Johnson Controls': 'johnsoncontrols',
    'Rockwell Automation': 'rockwellautomation',
    'Juniper Networks': 'junipernetworks',
    'Google Home': 'googlehome',
    'Amazon Alexa': 'amazonalexa',
    'Apple Home': 'apple',
    'Samsung SmartThings': 'smartthings',
    'Philips Hue': 'philipshue',
    'Schneider Electric': 'schneiderelectric'
  };
  const slug = map[name] || name.toLowerCase().replace(/\s+/g, '');
  return `https://cdn.simpleicons.org/${slug}`;
};
---

<section class="section partners-section" id="partners">
  <div class="container">
    <h2 class="section-title" style="text-align: center;">
      {isFa ? 'همراهان ' : 'Strategic '}<span class="gradient-text">{isFa ? 'استراتژیک' : 'Partners'}</span>
    </h2>
    <p class="section-subtitle" style="text-align: center; margin: 0 auto 40px;">
      {isFa ? 'برندهای معتبری که به آن‌ها افتخار می‌کنیم' : 'Prestigious brands we are proud to partner with'}
    </p>
    
    <div class="partners-grid" id="part-grid">
      {partners.map(name => (
        <div class="partner-item">
          <img 
            src={getLogoUrl(name)} 
            alt={name} 
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
          />
          <span class="brand-fallback">{name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partners-section { padding: 60px 0 100px; overflow: hidden; }
  
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 24px;
  }
  
  .partner-item {
    display: none;
    height: 80px;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: var(--soft-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    position: relative;
  }
  .partner-item:nth-child(-n+7) { display: flex; }
  
  .partner-item img { 
    max-width: 100%; 
    max-height: 100%; 
    object-fit: contain; 
    filter: var(--logo-filter); 
    transition: filter 0.3s; 
  }
  .partner-item:hover img { filter: var(--logo-filter-hover); }
  
  /* استایل زیبا برای متن جایگزین لوگو */
  .brand-fallback {
    display: none;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-align: center;
    color: var(--color-text);
    line-height: 1.2;
    padding: 4px;
    text-transform: uppercase;
  }
  .brand-fallback:hover {
    color: var(--color-accent);
  }
  
  @media (max-width: 1024px) { .partners-grid { grid-template-columns: repeat(5, 1fr); } }
  @media (max-width: 768px) { .partners-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 480px) { .partners-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
  var grid = document.getElementById('part-grid');
  if (grid) {
    var perSlide = 7;
    setInterval(function () {
      for (var i = 0; i < perSlide; i++) {
        grid.appendChild(grid.children[0]);
      }
    }, 5000);
  }
</script>