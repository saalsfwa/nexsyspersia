---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';

// لینک لوگوهای ترنسپرنت شرکت‌ها را اینجا قرار دهید
const partners = [
  'https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg',
  'https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg',
  'https://upload.wikimedia.org/wikipedia/commons/4/44/Microsoft_logo.svg',
  'https://upload.wikimedia.org/wikipedia/commons/f/fa/Apple_logo_black.svg',
  'https://upload.wikimedia.org/wikipedia/commons/0/08/Cisco_logo_blue_2016.svg'
];
---

<section class="section partners-section">
  <div class="container">
    <h2 class="section-title" style="text-align: center;">
      {isFa ? 'همراهان ' : 'Strategic '}<span class="gradient-text">{isFa ? 'استراتژیک' : 'Partners'}</span>
    </h2>
    <p class="section-subtitle" style="text-align: center; margin: 0 auto 60px;">
      {isFa ? 'برندهای معتبری که به آن‌ها افتخار می‌کنیم' : 'Prestigious brands we are proud to partner with'}
    </p>
    
    <div class="marquee-wrapper">
      <div class="marquee-content partners-track">
        {[...partners, ...partners].map(src => (
          <div class="partner-item">
            <img src={src} alt="Partner Logo" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .partners-section { padding: 60px 0 100px; overflow: hidden; }
  .partners-track { animation-duration: 25s; }
  .partner-item { 
    width: 180px; 
    height: 80px; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    padding: 16px; 
    background: rgba(255,255,255,0.02); 
    border: 1px solid var(--color-border); 
    border-radius: 8px; 
    flex-shrink: 0; 
    transition: all 0.3s ease;
  }
  .partner-item:hover { background: rgba(255,255,255,0.05); border-color: var(--color-accent); }
  .partner-item img { max-width: 100%; max-height: 100%; object-fit: contain; filter: brightness(0) invert(1) opacity(0.6); transition: filter 0.3s; }
  .partner-item:hover img { filter: brightness(0) invert(1) opacity(1); }
  
  @keyframes scrollRight {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
</style>