---
interface Props { lang?: 'fa' | 'en'; }
const { lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';

const partners = [
  'Cisco', 'Hewlett Packard Enterprise', 'Dell Technologies', 'IBM', 'Microsoft', 
  'Huawei', 'Palo Alto Networks', 'Fortinet', 'CrowdStrike', 'Check Point Software Technologies',
  'OpenAI', 'NVIDIA', 'Google DeepMind', 'Anthropic', 'Sophos',
  'Kaspersky', 'Hikvision', 'Dahua Technology', 'Axis Communications', 'Hanwha Vision',
  'Bosch', 'Avigilon', 'Siemens', 'Schneider Electric', 'Honeywell',
  'Johnson Controls', 'ABB', 'Rockwell Automation', 'Emerson', 'Carrier',
  'Nokia', 'Ericsson', 'Juniper Networks', 'CommScope', 'Crestron',
  'Lutron', 'KNX', 'Somfy', 'Legrand', 'Google Home',
  'Amazon Alexa', 'Apple Home', 'Samsung SmartThings', 'Philips Hue'
];

const getLogoUrl = (name: string) => {
  const map: Record<string, string> = {
    'Hewlett Packard Enterprise': 'hpe', 'Palo Alto Networks': 'paloaltonetworks',
    'Check Point Software Technologies': 'checkpoint', 'Google DeepMind': 'google',
    'Hanwha Vision': 'hanwha', 'Axis Communications': 'axis',
    'Johnson Controls': 'johnsoncontrols', 'Rockwell Automation': 'rockwellautomation',
    'Juniper Networks': 'junipernetworks', 'Google Home': 'googlehome',
    'Amazon Alexa': 'amazonalexa', 'Apple Home': 'apple',
    'Samsung SmartThings': 'smartthings', 'Philips Hue': 'philipshue',
    'Schneider Electric': 'schneiderelectric'
  };
  const slug = map[name] || name.toLowerCase().replace(/\s+/g, '');
  return `https://cdn.simpleicons.org/${slug}/FFFFFF`;
};
---

<section class="section partners-section" id="partners">
  <div class="container">
    <h2 class="section-title" style="text-align: center;">
      {isFa ? 'همراهان ' : 'Strategic '}<span class="gradient-text">{isFa ? 'استراتژیک' : 'Partners'}</span>
    </h2>
    <p class="section-subtitle" style="text-align: center; margin: 0 auto 40px;">
      {isFa ? 'برندهای معتبری که به آن‌ها افتخار می‌کنیم' : 'Prestigious brands we are proud to partner with'}
    </p>
    
    <div class="slider-container">
      <div class="slider-track" id="part-track">
        {[...partners, ...partners].map(name => (
          <div class="partner-item"><img src={getLogoUrl(name)} alt={name} loading="lazy" /></div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .partners-section { padding: 60px 0 100px; overflow: hidden; }
  .slider-container { width: 100%; overflow: hidden; mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); }
  .slider-track { display: flex; gap: 24px; transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform; }
  
  .partner-item { 
    width: calc((100% - 144px) / 7); /* دقیقاً ۷ آیتم در هر ردیف */
    height: 80px; 
    display: flex; align-items: center; justify-content: center; 
    padding: 16px; background: rgba(255,255,255,0.02); 
    border: 1px solid var(--color-border); border-radius: 8px; 
    flex-shrink: 0; transition: all 0.3s ease;
  }
  .partner-item:hover { background: rgba(255,255,255,0.05); border-color: var(--color-accent); transform: scale(1.05); }
  .partner-item img { max-width: 100%; max-height: 100%; object-fit: contain; opacity: 0.7; transition: opacity 0.3s; }
  .partner-item:hover img { opacity: 1; }
  
  @media (max-width: 1024px) { .partner-item { width: calc((100% - 96px) / 5); } }
  @media (max-width: 768px) { .partner-item { width: calc((100% - 48px) / 3); } }
  @media (max-width: 480px) { .partner-item { width: calc((100% - 24px) / 2); } }
</style>

<script>
  const section = document.getElementById('partners');
  if (section) {
    const track = section.querySelector('.slider-track');
    let currentIndex = 0;
    const itemsPerSlide = 7;
    const totalItems = track.children.length / 2;
    const maxIndex = totalItems - itemsPerSlide;
    
    function goToNext() {
      currentIndex++;
      if (currentIndex > maxIndex) currentIndex = 0;
      
      const itemWidth = track.firstElementChild!.offsetWidth + 24; // width + gap
      track.style.transform = `translateX(-${currentIndex * itemWidth}px)`;
    }

    // شروع اسلایدشو خودکار هر  ثانیه
    setInterval(goToNext, 5000);
  }
</script>